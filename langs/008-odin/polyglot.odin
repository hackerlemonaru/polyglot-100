// polyglot-100 :: entry 008 :: Odin
package main

import "core:fmt"

fib :: proc(n: int) -> u64 {
    a: u64 = 0
    b: u64 = 1
    for _ in 0 ..< n {
        t := a + b
        a = b
        b = t
    }
    return a
}

main :: proc() {
    sum := 0
    for i in 1 ..= 10 {
        sum += i
    }
    fmt.println("Hello from Odin!")
    fmt.printf("sum(1..10) = %d\n", sum)
    fmt.printf("fib(10)    = %d\n", fib(10))
}
