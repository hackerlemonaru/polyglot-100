# polyglot-100 :: entry 044 :: Janet
(defn fib [n]
  (var a 0)
  (var b 1)
  (for _ 0 n
    (def t (+ a b))
    (set a b)
    (set b t))
  a)

(defn sum-to [n]
  (var acc 0)
  (for i 1 (+ n 1)
    (set acc (+ acc i)))
  acc)

(def total (sum-to 10))

(print "Hello from Janet!")
(print "sum(1..10) = " total)
(print "fib(10)    = " (fib 10))
(assert (= total (fib 10)) "the 55 coincidence failed")
