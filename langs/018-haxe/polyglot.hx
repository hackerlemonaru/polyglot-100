// polyglot-100 :: entry 018 :: Haxe
class Polyglot {
    static function fib(n:Int):Float {
        var a:Float = 0;
        var b:Float = 1;
        for (_ in 0...n) {
            var t = a + b;
            a = b;
            b = t;
        }
        return a;
    }

    static function main() {
        var sum = 0;
        for (i in 1...11) sum += i;
        trace("Hello from Haxe!");
        Sys.println("sum(1..10) = " + sum);
        Sys.println("fib(10)    = " + fib(10));
    }
}
