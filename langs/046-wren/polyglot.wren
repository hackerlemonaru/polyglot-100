// polyglot-100 :: entry 046 :: Wren
class Polyglot {
  static fib(n) {
    var a = 0
    var b = 1
    for (i in 0...n) {
      var t = a + b
      a = b
      b = t
    }
    return a
  }

  static sumTo(n) {
    var acc = 0
    for (i in 1..n) acc = acc + i
    return acc
  }
}

var total = Polyglot.sumTo(10)
System.print("Hello from Wren!")
System.print("sum(1..10) = %(total)")
System.print("fib(10)    = %(Polyglot.fib(10))")
