// polyglot-100 :: entry 017 :: Vala
int64 fib (int n) {
    int64 a = 0;
    int64 b = 1;
    for (int i = 0; i < n; i++) {
        var t = a + b;
        a = b;
        b = t;
    }
    return a;
}

int main (string[] args) {
    int sum = 0;
    for (int i = 1; i <= 10; i++) {
        sum += i;
    }
    stdout.printf ("Hello from Vala!\n");
    stdout.printf ("sum(1..10) = %d\n", sum);
    stdout.printf ("fib(10)    = %s\n", fib (10).to_string ());
    return 0;
}
